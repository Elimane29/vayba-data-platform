# Copy to .env (never committed) and fill in. Read by dbt and ingestion/run.py.
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake user>
SNOWFLAKE_PRIVATE_KEY_FILE=<absolute path to rsa_key.p8, outside the repository>
VAYBA_RUNTIME=local

# Ingestion (part 1)
GCS_BUCKET=<landing bucket name>
GOOGLE_APPLICATION_CREDENTIALS=<absolute path to the service account JSON key, outside the repository>
