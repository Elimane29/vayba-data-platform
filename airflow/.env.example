# Copy to airflow/.env (never committed) and fill in.
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake user>
GCS_BUCKET=<landing bucket name>
GCP_PROJECT=<gcp project id>
# Host folders mounted read-only into each task (forward slashes on Windows)
VAYBA_KEYS_DIR=C:/Users/<you>/.snowflake
GCLOUD_CONFIG_DIR=C:/Users/<you>/AppData/Roaming/gcloud
